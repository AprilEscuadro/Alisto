[Unit]
Description=ALISTO first-time WiFi setup (hotspot + credential server)
# Runs BEFORE networking is expected to be up -- that's the whole point,
# it's what brings WiFi up in the first place on an unconfigured device.
Before=alisto-emergency.service

[Service]
Type=simple
User=root
# Needs root for nmcli hotspot/connect operations -- unlike
# alisto-emergency.service (which intentionally runs as the unprivileged
# alisto user), this one genuinely needs it.
ExecStart=/usr/bin/python3 -u /home/alisto/wifi_provision.py
# Exits on its own once already-connected (does nothing) or once it
# successfully hands off a WiFi connection -- Restart=no on purpose, this
# should run once per boot, not loop forever re-broadcasting a hotspot
# after it already succeeded.
Restart=no

[Install]
WantedBy=multi-user.target
